# NxtWave AI Workshop Growth Platform - Environment Variables Example
# If Supabase credentials are not provided, the application automatically runs in
# self-contained Local Demo Mode using browser persistence.

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=
